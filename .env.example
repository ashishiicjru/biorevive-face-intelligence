APP_NAME=Bio-Revive 360 Vision Suite
DATABASE_URL=sqlite:///./biorevive.db
# where saved snapshots live (only frames you click "Save snapshot" on)
DATA_DIR=./data
# where downloaded model files live
MODEL_DIR=./models
# auto | levi | deepface  (file-based apparent-age endpoint)
AGE_BACKEND=auto
# 1 = download recommended models in the background at server start
PRELOAD_MODELS=0
